generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  schema    String         @unique
  status    String         @default("active")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   TenantMember[]

  @@map("tenants")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   TenantMember[]

  @@map("users")
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PROFORMA
}

model Invoice {
  id                String        @id @default(cuid())
  number            String
  customerId        String?       @map("customer_id")
  issueDate         DateTime      @default(now()) @map("issue_date")
  dueDate           DateTime?     @map("due_date")
  status            InvoiceStatus @default(DRAFT)
  subtotal          Decimal       @db.Decimal(14, 2)
  vatTotal          Decimal       @db.Decimal(14, 2) @map("vat_total")
  total             Decimal       @db.Decimal(14, 2)
  isTaxInvoice      Boolean       @default(true) @map("is_tax_invoice")
  customFields      Json          @default("{}") @map("custom_fields")
  documentType      String        @default("INVOICE") @map("document_type")
  originalInvoiceId String?       @map("original_invoice_id")
  originalInvoice   Invoice?      @relation("InvoiceToCorrection", fields: [originalInvoiceId], references: [id])
  corrections       Invoice[]     @relation("InvoiceToCorrection")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model Product {
  id                String   @id @default(cuid())
  nameEn            String   @map("name_en")
  nameAr            String   @map("name_ar")
  sku               String   @unique
  barcode           String?
  imageUrl          String?  @map("image_url")
  unit              String   @default("Pcs")
  costPrice         Decimal  @default(0) @db.Decimal(14, 2) @map("cost_price")
  salesPrice        Decimal  @default(0) @db.Decimal(14, 2) @map("sales_price")
  taxCategory       String   @default("STANDARD") @map("tax_category")
  hsCode            String?  @map("hs_code")
  trackInventory    Boolean  @default(false) @map("track_inventory")
  qtyOnHand         Decimal  @default(0) @db.Decimal(14, 2) @map("qty_on_hand")
  qtyReserved       Decimal  @default(0) @db.Decimal(14, 2) @map("qty_reserved")
  reorderLevel      Decimal  @default(0) @db.Decimal(14, 2) @map("reorder_level")
  warehouseLocation String?  @map("warehouse_location")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("products")
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(14, 2)
  type        String
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("stock_movements")
}

model Vendor {
  id                 String   @id @default(uuid())
  nameEn             String   @map("name_en")
  nameAr             String   @map("name_ar")
  vatNumber          String   @unique @map("vat_number")
  crNumber           String?  @map("cr_number")
  email              String?
  phone              String?
  address            String?
  paymentTerms       String?  @map("payment_terms")
  outstandingBalance Decimal  @default(0) @db.Decimal(14, 2) @map("outstanding_balance")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("vendors")
}

model Bill {
  id               String   @id @default(uuid())
  number           String
  vendorInvoiceRef String?  @map("vendor_invoice_ref")
  vendorId         String?  @map("vendor_id")
  billDate         DateTime @default(now()) @map("bill_date")
  dueDate          DateTime? @map("due_date")
  status           String   @default("DRAFT")
  subtotal         Decimal  @db.Decimal(14, 2)
  vatTotal         Decimal  @db.Decimal(14, 2) @map("vat_total")
  total            Decimal  @db.Decimal(14, 2)
  customFields     Json     @default("{}") @map("custom_fields")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("bills")
}

model BillLine {
  id          String   @id @default(uuid())
  billId      String   @map("bill_id")
  description String
  qty         Decimal  @db.Decimal(14, 2)
  unitPrice   Decimal  @db.Decimal(14, 2) @map("unit_price")
  vatRate     Decimal  @default(15.00) @db.Decimal(5, 2) @map("vat_rate")
  lineTotal   Decimal  @db.Decimal(14, 2) @map("line_total")
  productId   String?  @map("product_id")

  @@map("bill_lines")
}

model NoteTemplate {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("note_templates")
}
